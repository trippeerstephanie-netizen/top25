<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<title>Limerick + Old Louisville Property Conditions Explorer</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<style>
*{box-sizing:border-box} html,body,#map{height:100%;margin:0}
body{font-family:system-ui,-apple-system,"Segoe UI",Arial,sans-serif;color:#172126;background:#eef1f2}
#map{position:absolute;inset:0}
.header{position:absolute;z-index:1000;top:12px;left:56px;right:12px;display:flex;gap:10px;align-items:flex-start;justify-content:space-between;pointer-events:none}
.card{background:#fffffff2;backdrop-filter:blur(8px);box-shadow:0 7px 26px #0002;border:1px solid #fff}
.brand{pointer-events:auto;border-radius:14px;padding:11px 14px;max-width:620px}
.brand h1{font-size:18px;margin:0 0 3px;line-height:1.15} .brand p{font-size:12px;margin:0;color:#69747a}
.controls{pointer-events:auto;display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}
.btn{border:1px solid #fff;background:#fffffff2;border-radius:9px;padding:8px 10px;font-size:12px;font-weight:760;cursor:pointer;box-shadow:0 7px 26px #0002}
.searchbox{position:absolute;z-index:1200;top:82px;left:56px;width:min(390px,calc(100vw - 76px));border-radius:12px;padding:6px;display:flex;gap:7px;background:#fffffff8;box-shadow:0 8px 30px #0003;border:2px solid #172126}
.searchbox input{flex:1;border:0;border-radius:8px;padding:8px 10px;font-size:13px;outline:none}
.searchbox .btn{box-shadow:none;background:#172126;color:white;border-color:#172126}
.results{display:none;position:absolute;z-index:1300;top:139px;left:56px;width:min(390px,calc(100vw - 76px));max-height:48vh;overflow:auto;background:white;border-radius:11px;box-shadow:0 7px 26px #0003}
.results.show{display:block} .res{padding:10px 12px;border-bottom:1px solid #edf0f2;cursor:pointer} .res:hover{background:#f5f7f8}
.res b{font-size:12px} .res small{display:block;color:#6c777d;margin-top:2px}
.panel{position:absolute;z-index:1000;right:12px;top:79px;width:325px;border-radius:14px;padding:12px;max-height:calc(100vh - 93px);overflow:auto}
.panel h2{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:#58636a;margin:1px 0 8px}
.layer{display:grid;grid-template-columns:auto 18px 1fr auto;gap:8px;align-items:center;padding:8px 3px;border-bottom:1px solid #edf0f1}
.layer label{font-size:13px;font-weight:720} .count{font-size:11px;color:#718087}
.swatch{width:15px;height:15px;display:inline-block}
.circle{border-radius:50%;background:#278ac7;border:1px solid #17242c}
.occ{border-radius:50%;background:#9c5bd6;border:1px solid #2c2531}
.outline{background:#7b3fc012;border:2px solid #7b3fc0}
.note{font-size:11px;line-height:1.45;color:#68747a;margin:10px 2px 1px}
.leaflet-popup-content-wrapper{border-radius:12px} .leaflet-popup-content{margin:12px 14px;min-width:230px}
.pop-title{font-size:14px;font-weight:800;margin-bottom:7px} .row{display:grid;grid-template-columns:98px 1fr;gap:8px;padding:5px 0;border-top:1px solid #eef0f1;font-size:12px}
.k{font-weight:700;color:#68747a} .v{word-break:break-word}
.search-pin{font-size:24px;line-height:24px}
@media(max-width:800px){
 .brand p{display:none} .controls{display:none} .header{left:50px;right:8px;top:8px}
