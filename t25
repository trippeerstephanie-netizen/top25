const map=L.map('map',{preferCanvas:true});
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'&copy; OpenStreetMap contributors'}).addTo(map);
const combinedBounds=L.latLngBounds([[38.218596018870755,-85.76832209003845],[38.245053754218226,-85.74993976376648]]);
map.fitBounds(combinedBounds.pad(.08));

const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
const row=(k,v)=>v!==undefined&&v!==null&&String(v).trim()!==''?`<div class="row"><div class="k">${esc(k)}</div><div class="v">${esc(v)}</div></div>`:'';
const popup=(title,rows)=>`<div class="pop-title">${esc(title)}</div>${rows.join('')}`;

// Assign neighborhood from the OFFICIAL boundary polygons, not from the source label.
function pointInRing(lon,lat,ring){
 let inside=false;
 for(let i=0,j=ring.length-1;i<ring.length;j=i++){
  const xi=ring[i][0], yi=ring[i][1], xj=ring[j][0], yj=ring[j][1];
  const hit=((yi>lat)!=(yj>lat)) && (lon < (xj-xi)*(lat-yi)/((yj-yi)||1e-15)+xi);
  if(hit) inside=!inside;
 }
 return inside;
}
function pointInGeometry(lon,lat,g){
 if(!g)return false;
 if(g.type==='Polygon') return g.coordinates.some((ring,i)=>i===0?pointInRing(lon,lat,ring):false) && !g.coordinates.slice(1).some(r=>pointInRing(lon,lat,r));
 if(g.type==='MultiPolygon') return g.coordinates.some(poly=>pointInGeometry(lon,lat,{type:'Polygon',coordinates:poly}));
 return false;
}
function officialNeighborhood(f){
 if(!f?.geometry || f.geometry.type!=='Point') return null;
 const [lon,lat]=f.geometry.coordinates;
 // Limerick overlaps the larger Old Louisville polygon in the supplied boundary data,
 // so test Limerick first and let it win inside its official polygon.
 const order=['Limerick','Old Louisville'];
 for(const name of order){
  const b=DATA_BOUNDS.features.find(x=>x.properties?.name===name);
  if(b && pointInGeometry(lon,lat,b.geometry)) return name;
 }
 return null;
}
function normalizeNeighborhoods(fc){
 fc.features.forEach(f=>{
  const n=officialNeighborhood(f);
  f.properties=f.properties||{};
  f.properties.neighborhood=n ? n.toUpperCase() : 'OUTSIDE MAPPED NEIGHBORHOODS';
 });
}
normalizeNeighborhoods(DATA_WORK);
normalizeNeighborhoods(DATA_OCC);
const canvas=L.canvas({padding:.5});

function workColor(t){t=(t||'').toLowerCase();if(t.includes('annual'))return'#2c97de';if(t.includes('lot maintenance'))return'#47b76b';if(t.includes('cutting'))return'#a06bd8';if(t.includes('graffiti'))return'#e58b3f';if(t.includes('boarding'))return'#e04646';return'#6d7880';}
function occColor(o){o=(o||'').toLowerCase();if(o.includes('abandoned'))return'#d54a45';if(o.includes('vacant'))return'#9c5bd6';if(o.includes('condemned'))return'#24282c';if(o.includes('occupied'))return'#3f9a69';return'#68747a';}

const workLayer=L.geoJSON(DATA_WORK,{
 renderer:canvas,
 pointToLayer:(f,ll)=>L.circleMarker(ll,{radius:7,weight:1.7,color:'#111',fillColor:workColor(f.properties.record_type),fillOpacity:.95}),
 onEachFeature:(f,l)=>{
   const p=f.properties;
   const addr=p.address||'ADDRESS NOT AVAILABLE';
   const content=
     '<div style="font-size:18px;font-weight:900;line-height:1.2;margin-bottom:8px">📍 '+esc(addr)+'</div>'+
     row('ADDRESS',addr)+
     row('Neighborhood',p.neighborhood)+
     row('Record ID',p.record_id)+
     row('Record type',p.record_type)+
     row('Status',p.status)+
     row('Description',p.description)+
     row('Date opened',p.date_opened)+
     row('ZIP',p.zip)+
     row('Council district',p.district);
   l.bindTooltip(addr,{direction:'top',sticky:true,opacity:.95});
   l.on('click',e=>L.popup({maxWidth:420}).setLatLng(e.latlng).setContent(content).openOn(map));
 }
}).addTo(map);

const isOccupied=f=>String(f.properties.occupancy||'').trim().toLowerCase().startsWith('occupied');
const occupiedData={"type":"FeatureCollection","features":DATA_OCC.features.filter(isOccupied)};
const unoccupiedData={"type":"FeatureCollection","features":DATA_OCC.features.filter(f=>!isOccupied(f))};

function countNeighborhood(fc,name){return fc.features.filter(f=>f.properties.neighborhood===name.toUpperCase()).length;}
document.getElementById('workCount').textContent=DATA_WORK.features.length;
document.getElementById('occupiedCount').textContent=occupiedData.features.length;
document.getElementById('unoccupiedCount').textContent=unoccupiedData.features.length;
const limOcc=countNeighborhood(DATA_OCC,'Limerick'), olOcc=countNeighborhood(DATA_OCC,'Old Louisville');
const limWork=countNeighborhood(DATA_WORK,'Limerick'), olWork=countNeighborhood(DATA_WORK,'Old Louisville');
document.getElementById('neighborhoodSummary').innerHTML='<b>Mapped records by official boundary:</b> Limerick has '+limOcc+' occupancy/inspection records and '+limWork+' open PM work orders; Old Louisville has '+olOcc+' occupancy/inspection records and '+olWork+' open PM work orders.';

function makeOccLayer(data){
 return L.geoJSON(data,{
  renderer:canvas,
  pointToLayer:(f,ll)=>L.circleMarker(ll,{radius:6,weight:1.4,color:'#241f27',fillColor:occColor(f.properties.occupancy),fillOpacity:.82}),
  onEachFeature:(f,l)=>{
   const p=f.properties;
   const addr=p.address||'ADDRESS NOT AVAILABLE';
   const content=
     '<div style="font-size:18px;font-weight:900;line-height:1.2;margin-bottom:8px">📍 '+esc(addr)+'</div>'+
     row('ADDRESS',addr)+
     row('Neighborhood',p.neighborhood)+
     row('Occupancy',p.occupancy)+
     row('Status',p.status)+
     row('Inspection date',p.inspection_date)+
     row('ZIP',p.zip)+
     row('Council district',p.district);
   l.bindTooltip(addr,{direction:'top',sticky:true,opacity:.95});
   l.on('click',e=>L.popup({maxWidth:420}).setLatLng(e.latlng).setContent(content).openOn(map));
  }
 });
}
const occupiedLayer=makeOccLayer(occupiedData).addTo(map);
const unoccupiedLayer=makeOccLayer(unoccupiedData).addTo(map);
workLayer.bringToFront();

const boundLayer=L.geoJSON(DATA_BOUNDS,{
 style:f=>({color:f.properties.name==='Limerick'?'#c13b80':'#336fb6',weight:3,fillColor:f.properties.name==='Limerick'?'#c13b80':'#336fb6',fillOpacity:.045}),
 onEachFeature:(f,l)=>l.bindPopup(popup('Neighborhood',[row('Name',f.properties.name)]))
}).addTo(map);

document.getElementById('workToggle').onchange=e=>e.target.checked?workLayer.addTo(map):map.removeLayer(workLayer);
document.getElementById('occupiedToggle').onchange=e=>e.target.checked?occupiedLayer.addTo(map):map.removeLayer(occupiedLayer);
document.getElementById('unoccupiedToggle').onchange=e=>e.target.checked?unoccupiedLayer.addTo(map):map.removeLayer(unoccupiedLayer);
document.getElementById('boundsToggle').onchange=e=>e.target.checked?boundLayer.addTo(map):map.removeLayer(boundLayer);

const nbBounds={};
boundLayer.eachLayer(l=>nbBounds[l.feature.properties.name]=l.getBounds());
document.getElementById('bothBtn').onclick=()=>map.fitBounds(combinedBounds.pad(.08));
document.getElementById('limBtn').onclick=()=>map.fitBounds(nbBounds['Limerick'].pad(.12));
document.getElementById('olBtn').onclick=()=>map.fitBounds(nbBounds['Old Louisville'].pad(.08));

const localIndex=[];
function addIndex(fc,kind){
 fc.features.forEach(f=>{const p=f.properties;if(p.address&&f.geometry&&f.geometry.type==='Point')localIndex.push({label:p.address,sub:kind+' · '+(p.neighborhood||'Unknown neighborhood'),ll:[f.geometry.coordinates[1],f.geometry.coordinates[0]]})})
}
addIndex(DATA_WORK,'Open PM work order');
addIndex(DATA_OCC,'Occupancy / inspection record');

let marker=null;
function showResults(items){
 const box=document.getElementById('results');
 box.innerHTML=items.join('')||'<div class="res"><b>No matches</b><small>Try street number + street name.</small></div>';
 box.classList.add('show');
}
async function search(){
 const raw=document.getElementById('search').value.trim();
 const q=raw.toLowerCase();
 if(q.length<2)return;
 const local=localIndex.filter(x=>x.label.toLowerCase().includes(q)).slice(0,8);
 showResults(local.map((h,i)=>`<div class="res" data-local="${i}"><b>${esc(h.label)}</b><small>${esc(h.sub)}</small></div>`).concat(
 ['<div class="res"><b>Searching all street addresses…</b><small>OpenStreetMap address lookup</small></div>']));
 document.querySelectorAll('[data-local]').forEach(el=>el.onclick=()=>{const h=local[+el.dataset.local];map.setView(h.ll,18);if(marker)map.removeLayer(marker);marker=L.circleMarker(h.ll,{radius:10,color:'#111',weight:3,fillOpacity:0}).addTo(map);document.getElementById('results').classList.remove('show')});

 try{
  const viewbox='-85.76832209003845,38.245053754218226,-85.74993976376648,38.218596018870755';
  const url='https://nominatim.openstreetmap.org/search?format=jsonv2&limit=8&countrycodes=us&bounded=1&viewbox='+encodeURIComponent(viewbox)+'&q='+encodeURIComponent(raw+', Louisville, KY');
  const r=await fetch(url,{headers:{'Accept':'application/json'}});
  const g=await r.json();
  const web=g.map(x=>({label:x.display_name,ll:[+x.lat,+x.lon]}));
  showResults(
   local.map((h,i)=>`<div class="res" data-local="${i}"><b>${esc(h.label)}</b><small>${esc(h.sub)}</small></div>`).concat(
   web.map((h,i)=>`<div class="res" data-web="${i}"><b>${esc(h.label.split(',').slice(0,4).join(','))}</b><small>Street address</small></div>`))
  );
  document.querySelectorAll('[data-local]').forEach(el=>el.onclick=()=>{const h=local[+el.dataset.local];map.setView(h.ll,18);if(marker)map.removeLayer(marker);marker=L.circleMarker(h.ll,{radius:10,color:'#111',weight:3,fillOpacity:0}).addTo(map);document.getElementById('results').classList.remove('show')});
  document.querySelectorAll('[data-web]').forEach(el=>el.onclick=()=>{const h=web[+el.dataset.web];if(marker)map.removeLayer(marker);marker=L.marker(h.ll).addTo(map).bindPopup(popup('Address Search',[row('Location',h.label)])).openPopup();map.setView(h.ll,18);document.getElementById('results').classList.remove('show')});
 }catch(err){
  if(!local.length)showResults(['<div class="res"><b>External address search unavailable</b><small>Internet access is required for addresses not already in the datasets.</small></div>']);
 }
}
document.getElementById('searchBtn').onclick=search;
document.getElementById('search').addEventListener('keydown',e=>{if(e.key==='Enter')search()});
</script>
